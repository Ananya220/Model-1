<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CSS Selectors Example</title>

    <style>

        /* Universal Selector */
        * {
            font-family: Arial, sans-serif;
        }

        /* Element Selector */
        h1 {
            color: darkblue;
            text-align: center;
        }

        /* Class Selector */
        .box {
            background-color: lightblue;
            padding: 15px;
            margin: 10px;
            border-radius: 10px;
        }

        /* ID Selector */
        #special {
            color: red;
            font-size: 22px;
        }

        /* Group Selector */
        h2, p {
            color: darkgreen;
        }

        /* Descendant Selector */
        div p {
            font-style: italic;
        }

        /* Hover Selector */
        button:hover {
            background-color: black;
            color: white;
        }

        /* Attribute Selector */
        input[type="text"] {
            border: 2px solid blue;
            padding: 5px;
        }

    </style>
</head>

<body>

    <h1>CSS Selectors Example</h1>

    <div class="box">
        <h2>This is a Heading</h2>

        <p>
            This paragraph is inside a div.
        </p>
    </div>

    <p id="special">
        This paragraph uses an ID selector.
    </p>

    <input type="text" placeholder="Enter your name">

    <br><br>

    <button>Click Me</button>

</body>
</html>
